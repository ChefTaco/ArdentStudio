# ArdentStudio configuration. Copy to a private env file; never commit real values.
# `ardent-studio env` lists every variable with its description.

ARDENT_STUDIO_DATA=/data
# ARDENT_STUDIO_HOST=127.0.0.1
# ARDENT_STUDIO_PORT=8097
# ARDENT_STUDIO_MAX_BLOB_BYTES=67108864
# ARDENT_STUDIO_EVENT_RETENTION_DAYS=30
# ARDENT_STUDIO_LOG_LEVEL=info

# Oathweave: browser tokens for the audience `ardentstudio`
OATHWEAVE_ISSUER=https://identity.example.com
OATHWEAVE_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OATHWEAVE_USERINFO_URL=https://identity.example.com/api/v1/oauth/userinfo
# Optional comma-separated Oathweave native issuer ids, accepted for service tokens on the audit export only.
OATHWEAVE_NATIVE_ISSUERS=
ARDENT_STUDIO_OATHWEAVE_IDENTITIES_JSON=[{"issuer":"https://identity.example.com","subject":"example-subject","localUserId":"operator"}]

# Oathweave: ArdentStudio's own machine clients (client_credentials), one per audience
ARDENT_STUDIO_OATHWEAVE_TOKEN_URL=https://identity.example.com/api/v1/oauth/token

ARDENT_STUDIO_MAGNUS_URL=https://magnus.example.com
ARDENT_STUDIO_MAGNUS_CLIENT_ID=ardentstudio-magnus
ARDENT_STUDIO_MAGNUS_CLIENT_SECRET=replace-with-the-magnus-client-secret
# ARDENT_STUDIO_MAGNUS_SCOPE=

ARDENT_STUDIO_HIVEMEM_URL=https://hivemem.example.com
ARDENT_STUDIO_HIVEMEM_CLIENT_ID=ardentstudio-hivemem
ARDENT_STUDIO_HIVEMEM_CLIENT_SECRET=replace-with-the-hivemem-client-secret
# ARDENT_STUDIO_HIVEMEM_SCOPE=

# Optional one-way announcements (the URL contains its secret)
# ARDENT_STUDIO_CHATTERMOST_WEBHOOK_URL=https://chat.example.com/api/v4/webhooks/incoming/<id>/<secret>

# Private CA for service URLs: Node reads NODE_EXTRA_CA_CERTS
# NODE_EXTRA_CA_CERTS=/etc/ardent-studio/ca.pem
